# 어드민 로그인 비밀번호 (필수)
ADMIN_PASSWORD=change-me
# 세션 서명용 비밀값 (임의의 긴 문자열)
SESSION_SECRET=replace-with-a-long-random-string

# /admin 프록시용: 이 어드민 앱의 배포 주소, 폼 전송을 허용할 사이트 도메인
ASSET_PREFIX=
ALLOWED_ORIGINS=iyaon-site.vercel.app

# (선택) Upstash Redis / Vercel KV — 설정하면 데이터가 영구 저장됩니다
KV_REST_API_URL=
KV_REST_API_TOKEN=
