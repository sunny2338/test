# 어드민 로그인 비밀번호 (필수)
ADMIN_PASSWORD=change-me
# 세션 서명용 비밀값 (임의의 긴 문자열)
SESSION_SECRET=replace-with-a-long-random-string
# /admin 프록시용: 이 어드민 앱 주소, 허용할 사이트 도메인
# (선택) Upstash Redis / Vercel KV — 설정하면 데이터가 영구 저장됩니다
ASSET_PREFIX=
ALLOWED_ORIGINS=iyaon-site.vercel.app

KV_REST_API_URL=
